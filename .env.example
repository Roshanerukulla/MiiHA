# Copy this file to .env and fill in your values
# Generate a strong JWT secret: python -c "import secrets; print(secrets.token_hex(32))"

# MongoDB
MONGODB_URI=mongodb://localhost:27017
DATABASE_NAME=miha

# JWT — must be at least 32 characters
JWT_SECRET_KEY=replace-with-a-strong-random-secret-at-least-32-chars

# Cohere
COHERE_API_KEY=your-cohere-api-key-here

# FAISS index + metadata paths (optional — defaults to app/db and app/data/metadata)
# FAISS_DIR=/absolute/path/to/db
# METADATA_DIR=/absolute/path/to/data/metadata

# LLM config (optional — shown with defaults)
# COHERE_RERANK_MODEL=rerank-english-v3.0
# COHERE_GENERATE_MODEL=command-r-plus
# ST_MODEL=sentence-transformers/all-MiniLM-L6-v2
# MAX_TOKENS=300
# TEMPERATURE=0.5
# TOP_K_DEFAULT=15
# RERANK_TOP_N=3
